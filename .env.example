# Copy this file to .env.local and fill in real values.
# Never commit actual keys — .env.local is gitignored.

# Required. OpenAI Images API (gpt-image-2.5-flare) — primary generation engine.
# Server-side only, used in lib/openai-image.ts.
OPENAI_API_KEY=

# Required. fal.ai (FLUX PuLID) — dev fallback engine, selectable via ?provider=pulid.
# Server-side only, used in lib/fal.ts.
FAL_KEY=

# Required (for the automatic Living Ending / Veo demo path). Google Gemini
# (Veo 3.1) — animates the generated still into a short clip.
# Server-side only, used in lib/veo.ts.
GEMINI_API_KEY=

# Required (for the automatic Living Ending). Vercel Blob read/write token —
# create a Blob store in the Vercel dashboard (Storage tab) to get one.
# When deployed on Vercel with a store linked to the project, this is
# injected automatically; set it manually for local development.
# Server-side only, used in lib/blob.ts.
BLOB_READ_WRITE_TOKEN=

# Optional. Shows the "BRING THIS LIFE ALIVE — VEO DEMO" button when set to "true".
# This is a plain feature flag, not a secret, hence the NEXT_PUBLIC_ prefix
# (required for a client component to read it). Defaults to false/hidden
# when unset — leave unset or "false" in production unless a demo is wanted.
NEXT_PUBLIC_ENABLE_VEO_DEMO=false

# Optional but recommended for a limited/private link-based release.
# Shared access code gating the whole app (middleware.ts + app/access,
# app/api/access/verify). Server-side only — never sent to the browser
# except as an httpOnly cookie set after a correct submission. Leave unset
# to disable the gate entirely (app stays open to anyone with the link).
AI_MIRROR_ACCESS_CODE=
